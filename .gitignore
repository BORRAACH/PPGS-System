# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Pedidos gerados em tempo de execução
pedidos/*

# Versão instalada nessa máquina, gerada automaticamente a cada execução
# (informativo, não usado pra decidir nada) — ver Config/atualizador.py
Config/.versao

# Preferências de estilo da comanda impressa (negrito/sublinhado/fundo
# preto/fonte grande por campo, espaçamento) — editado pela tela
# Configurações, específico de cada máquina/impressora, não código-fonte.
# Ver services/comandaEstiloService.py.
Config/estilo_impressao.json

# Escolha manual de qual máquina da malha imprime (tela Rede.qml),
# específica de cada máquina/rede local, não código-fonte. Ver
# services/rede/impressoraFixada.py.
Config/impressora_fixada.json

# Log de diagnóstico (stdout/stderr redirecionados + rotação) — gerado em
# tempo de execução, específico de cada máquina. Ver Config/logConfig.py.
logs/
